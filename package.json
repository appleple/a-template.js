{
  "name": "a-template",
  "version": "0.6.1",
  "author": "appleple",
  "description": "Simple Template Engine",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/appleple/a-template.js.git"
  },
  "bugs": {
    "url": "https://github.com/appleple/a-template.js/issues"
  },
  "homepage": "https://github.com/appleple/a-template.js#readme",
  "scripts": {
    "test": "npm run lint && npm run test:ci",
    "test:ci": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "build": "tsup",
    "watch": "tsup --watch",
    "prepack": "npm run lint:check && npm run test:ci && npm run build",
    "patch": "npm version patch && git push --follow-tags",
    "minor": "npm version minor && git push --follow-tags",
    "major": "npm version major && git push --follow-tags"
  },
  "main": "./lib/index.js",
  "module": "./lib/index.mjs",
  "exports": {
    ".": {
      "import": "./lib/index.mjs",
      "require": "./lib/index.js"
    },
    "./build/*": "./build/*"
  },
  "files": [
    "lib",
    "build"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "globals": "^17.9.0",
    "jsdom": "^30.0.1",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "delegate": "^3.1.2",
    "morphdom": "^2.3.1"
  }
}
